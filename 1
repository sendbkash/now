
<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secure Checkout</title>

    <link href="https://fonts.googleapis.com/css2?family=Baloo+Da+2:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Poppins', 'Baloo Da 2', sans-serif;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(350deg, #f4f9ff, #edf4ff);
            padding: 25px 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #6D7F9A;
        }

        .checkout {
            width: 100%;
            max-width: 650px;
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 8px 30px rgba(0, 87, 208, .08);
        }

        .navbar {
            height: 48px;
            background: #fbfcff;
            border: 1px solid #edf1f8;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 15px;
        }

        .navbar a, .navbar button {
            color: #6D7F9A;
            text-decoration: none;
            background: none;
            border: none;
            font-size: 20px;
            cursor: pointer;
        }

        .payment-header {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin: 25px 0 15px;
        }

        .bkash-logo {
            width: 100%;
            text-align: center;
            margin-bottom: 8px;
            color: #e2136e;
            font-size: 30px;
            font-weight: 700;
        }

        .merchant {
            display: flex;
            align-items: center;
            gap: 14px;
            background: #fbfcff;
            border: 1px solid #edf1f8;
            border-radius: 9px;
            padding: 14px;
            flex: 1;
            min-width: 200px;
        }

        .merchant-icon {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #e2136e;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 23px;
            font-weight: bold;
        }

        .merchant h3 {
            font-size: 16px;
            color: #52647d;
        }

        .merchant p {
            font-size: 13px;
            margin-top: 3px;
        }

        .amount {
            background: #fbfcff;
            border: 1px solid #edf1f8;
            border-radius: 9px;
            padding: 18px 15px;
            text-align: center;
            min-width: 120px;
            font-size: 22px;
            font-weight: 700;
        }

        .payment-box {
            background: #cf2771;
            padding: 22px;
            margin-top: 15px;
            border-radius: 10px;
            color: white;
        }

        .payment-box h2 {
            text-align: center;
            font-size: 19px;
            margin-bottom: 13px;
        }

        input {
            width: 100%;
            padding: 14px 16px;
            border: none;
            border-radius: 9px;
            outline: none;
            font-size: 15px;
            background: #fbfcff;
            color: #52647d;
        }

        .instructions {
            list-style: none;
            margin-top: 20px;
        }

        .instructions li {
            font-size: 14px;
            line-height: 1.8;
            padding: 11px 0;
            border-bottom: 1px solid rgba(255,255,255,.18);
        }

        .highlight {
            color: #ffeb3b;
            font-weight: 700;
        }

        .copy-btn {
            background: rgba(0,0,0,.2);
            color: white;
            border: none;
            border-radius: 5px;
            padding: 5px 9px;
            cursor: pointer;
            margin-left: 5px;
        }

        .verify-btn {
            width: 100%;
            margin-top: 18px;
            padding: 15px;
            border: none;
            border-radius: 9px;
            background: #cf2771;
            color: white;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
        }

        .verify-btn:hover {
            background: #e73985;
        }

        .notice {
            display: none;
            background: #fff3cd;
            color: #856404;
            padding: 12px;
            border-radius: 8px;
            margin-top: 12px;
            font-size: 13px;
            text-align: center;
        }

        @media (max-width: 480px) {
            .checkout {
                padding: 15px;
            }

            .payment-header {
                flex-direction: column;
                align-items: stretch;
            }

            .amount {
                width: 100%;
            }

            .payment-box {
                padding: 17px;
            }
        }
    </style>
</head>

<body>

<div class="checkout">

    <div class="navbar">
        <a href="#" onclick="history.back(); return false;">&#8592;</a>
        <button type="button" onclick="showNotice()">&#10005;</button>
    </div>

    <div class="payment-header">

        <div class="bkash-logo">bKash</div>

        <div class="merchant">
            <div class="merchant-icon">R</div>
            <div>
                <h3>YOUR WEBSITE NAME</h3>
                <p>ইনভয়েস আইডি:</p>
                <p id="invoice">YOUR-INVOICE-ID</p>
            </div>
        </div>

        <div class="amount">
            ৳ 0.00
        </div>

    </div>

    <form id="paymentForm">

        <div class="payment-box">

            <h2>ট্রানজেকশন আইডি দিন</h2>

            <input
                type="text"
                id="transactionId"
                name="transaction_id"
                placeholder="ট্রানজেকশন আইডি দিন"
                maxlength="10"
                required
            >

            <ul class="instructions">

                <li>
                    *247# ডায়াল করে আপনার bKash মোবাইল মেনুতে যান অথবা bKash অ্যাপে যান।
                </li>

                <li>
                    <span class="highlight">Send Money</span> অপশনে ক্লিক করুন।
                </li>

                <li>
                    প্রাপক নম্বর হিসেবে এই নম্বরটি লিখুন:
                    <span class="highlight" id="receiverNumber">YOUR_BKASH_NUMBER</span>

                    <button type="button" class="copy-btn" onclick="copyNumber()">
                        Copy
                    </button>
                </li>

                <li>
                    টাকার পরিমাণ:
                    <span class="highlight">৳ 0.00</span>
                </li>

                <li>
                    নিশ্চিত করতে আপনার bKash PIN লিখুন।
                </li>

                <li>
                    সবকিছু ঠিক থাকলে bKash থেকে একটি নিশ্চিতকরণ বার্তা পাবেন।
                </li>

                <li>
                    এখন উপরের বক্সে আপনার
                    <span class="highlight">Transaction ID</span>
                    দিন এবং নিচের VERIFY বাটনে ক্লিক করুন।
                </li>

            </ul>

        </div>

        <button type="submit" class="verify-btn">
            VERIFY
        </button>

        <div class="notice" id="notice">
            পেমেন্ট যাচাই ব্যবস্থা এখনো API-এর সাথে যুক্ত করা হয়নি।
        </div>

    </form>

</div>

<script>
    function copyNumber() {
        const number = document.getElementById("receiverNumber").innerText;

        if (number === "YOUR_BKASH_NUMBER") {
            alert("আগে নিজের bKash নম্বর বসান।");
            return;
        }

        navigator.clipboard.writeText(number)
            .then(() => alert("নম্বর কপি হয়েছে!"))
            .catch(() => alert("কপি করা যায়নি।"));
    }

    function showNotice() {
        document.getElementById("notice").style.display = "block";
    }

    document.getElementById("paymentForm").addEventListener("submit", function(e) {
        e.preventDefault();

        const trxId = document.getElementById("transactionId").value.trim();

        if (trxId.length < 8) {
            alert("সঠিক Transaction ID দিন।");
            return;
        }

        document.getElementById("notice").style.display = "block";
    });
</script>

</body>
</html>
